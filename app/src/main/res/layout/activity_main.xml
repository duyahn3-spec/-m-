<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1A0A2E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ CU TO KHỦNG BỐ ⚡"
                android:textColor="#FF00FF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:shadowColor="#FF00FF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="20"
                android:letterSpacing="0.15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HDuong 👑 DZ🗿 Vêlol!"
                android:textColor="#FFD700"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="#FFD700"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 AI DRIVER v4.0 · TÀU KHỦNG"
                android:textColor="#00FFFF"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔧 CÀI ĐẶT LÁP"
                android:textColor="#AA00FF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Sukac (Sensitivity)"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/seekBarSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="20000"
                android:progress="20000"
                android:progressTint="#FF00FF"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📐 Vuốt Cu (Density)"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/seekBarDensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="400"
                android:min="100"
                android:progress="120"
                android:progressTint="#00FF00"
                android:layout_marginBottom="10dp" />

            <!-- Switch 1: Đã thêm layout_width và layout_height -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ Địt Con Mẹ"
                    android:textColor="#FFFFFF" />
                <Switch
                    android:id="@+id/switchSuperTouch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="#FF00FF" />
            </LinearLayout>

            <!-- Switch 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚀 Sàm Lon"
                    android:textColor="#FFFFFF" />
                <Switch
                    android:id="@+id/switchPointerSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="#00BFFF" />
            </LinearLayout>

            <!-- Switch 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎮 Lọ Lọ Lọ"
                    android:textColor="#FFFFFF" />
                <Switch
                    android:id="@+id/switchDispatch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#FF00FF" />
            </LinearLayout>

        </LinearLayout>

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🥵 Lọ để kích hoạt..."
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:background="#111111"
            android:layout_marginBottom="14dp" />

        <!-- Button -->
        <Button
            android:id="@+id/btnActivate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⚡ ĐẬP LỌ NGAY"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:background="#4CAF50"
            android:fontFamily="sans-serif-condensed" />

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="😈 Vợ Chú Để Anh 👑 Hải Dương 🗿"
            android:textColor="#FF4500"
            android:textSize="14sp"
            android:textStyle="bold"
            android:shadowColor="#FF0000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6" />

    </LinearLayout>
</ScrollView>
