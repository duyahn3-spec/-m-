<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0D0D0D"
    android:padding="24dp">

    <!-- Tiêu đề (giữ nguyên) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎮 CUTO GAMEPAD"
        android:textColor="#00FF00"
        android:textSize="32sp"
        android:textStyle="bold"
        android:shadowColor="#00FF00"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="15" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fake tay cầm chơi game - Cực nhạy"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginBottom="20dp" />

    <!-- Thanh trượt độ nhạy (thêm mới) -->
    <TextView
        android:id="@+id/tvSensitivityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Độ nhạy (hiện tại: 20000)"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <SeekBar
        android:id="@+id/sensitivitySeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="20000"
        android:progress="20000"
        android:layout_marginBottom="20dp" />

    <!-- Chữ chửi thề (thay cho trigger edge) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Địt Mẹ thằng lòn ngu căk!🤬"
        android:textColor="#FF4444"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- Nút bấm chính (giữ nguyên) -->
    <Button
        android:id="@+id/btnActivate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🎮 BẬT GAMEPAD ẢO"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:background="#4CAF50"
        android:fontFamily="sans-serif-condensed" />

</LinearLayout>
